DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=product
POSTGRES_USER=product
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DJANGO_HTTPS=0
TRUST_PROXY=0
# External GPT is off until the operator explicitly permits document transfer.
OPENAI_ENABLED=0
# Local enrollment is optional; production Compose requires two factors.
DJANGO_REQUIRE_2FA=0
DJANGO_AXES_FAILURE_LIMIT=5
DJANGO_AXES_COOLOFF_MINUTES=30
