# Production configuration only. Passwords and API keys belong in .secrets/.
# Use a DNS name whose A/AAAA records point to your organization's server.
APP_DOMAIN=

# Keep APP_IMAGE and BACKUP_IMAGE on the same release (or matching sha-* tags).
# For reproducible updates, pin a verified sha-* tag or image@sha256:digest.
APP_IMAGE=ghcr.io/kd170703/product:main
BACKUP_IMAGE=ghcr.io/kd170703/product-backup:main

POSTGRES_DB=product
POSTGRES_USER=product
OPENAI_ENABLED=0
OPENAI_MODEL=gpt-4.1-mini

# Local encrypted backup repository; use a disk hosted in Russia.
BACKUP_DIRECTORY=./backups-prod
BACKUP_TIME=03:00
BACKUP_TIMEZONE=Europe/Moscow
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
